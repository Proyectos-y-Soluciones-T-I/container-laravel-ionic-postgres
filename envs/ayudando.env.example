# ── Ayudando — variables de entorno ───────────────────────────────────────────
# Copiá este archivo: cp envs/ayudando.env.example envs/ayudando.env
# Nunca subas envs/ayudando.env a git.

# Laravel
APP_KEY=                          # php artisan key:generate --show
JWT_SECRET=                       # string aleatorio largo (mínimo 64 chars)

# Mail (SMTP)
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=                # por defecto usa MAIL_USERNAME

# Opcionales
INSTALL_FORMLY=no                 # yes = instala @ngx-formly/core al primer arranque
