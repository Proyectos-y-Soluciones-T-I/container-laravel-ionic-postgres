server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # ── Static dashboard ────────────────────────────────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(css|js|ico|png|jpg|svg)$ {
        expires 1d;
        add_header Cache-Control "public";
    }

    # ── Health check proxies ─────────────────────────────────────────────────────
    # Uses the bridge gateway IP (HOST_IP env var injected by docker-compose)
    # instead of host.docker.internal, which resolves to IPv6 on Docker Desktop
    # for Windows and causes "Network unreachable" errors.

    location = /health/ayudando/frontend {
        set $upstream http://$HOST_IP:4200;
        proxy_pass $upstream;
        proxy_connect_timeout 2s;
        proxy_read_timeout    3s;
        proxy_intercept_errors off;
        access_log off;
    }

    location = /health/ayudando/backend {
        set $upstream http://$HOST_IP:8080;
        proxy_pass $upstream;
        proxy_connect_timeout 2s;
        proxy_read_timeout    3s;
        proxy_intercept_errors off;
        access_log off;
    }

    location = /health/emergencias/frontend {
        set $upstream http://$HOST_IP:4201;
        proxy_pass $upstream;
        proxy_connect_timeout 2s;
        proxy_read_timeout    3s;
        proxy_intercept_errors off;
        access_log off;
    }

    location = /health/emergencias/backend {
        set $upstream http://$HOST_IP:8081;
        proxy_pass $upstream;
        proxy_connect_timeout 2s;
        proxy_read_timeout    3s;
        proxy_intercept_errors off;
        access_log off;
    }

    location = /health/fiscalizacion/frontend {
        set $upstream http://$HOST_IP:4202;
        proxy_pass $upstream;
        proxy_connect_timeout 2s;
        proxy_read_timeout    3s;
        proxy_intercept_errors off;
        access_log off;
    }

    location = /health/fiscalizacion/backend {
        set $upstream http://$HOST_IP:8082;
        proxy_pass $upstream;
        proxy_connect_timeout 2s;
        proxy_read_timeout    3s;
        proxy_intercept_errors off;
        access_log off;
    }

    access_log off;
    error_log /dev/stderr warn;
}
