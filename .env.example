# ─── Project selector ─────────────────────────────────────────────────────────
# Valid values: ayudando (default), emergencias, fiscalizacion
# Usage: make up PROJECT=ayudando
PROJECT=ayudando
#
# Per-project port allocation:
#   Project       | Nginx | Frontend | PostgreSQL | pgAdmin
#   --------------|-------|----------|------------|--------
#   ayudando      | 8080  | 4200     | 5432       | 5050
#   emergencias   | 8081  | 4201     | 5433       | 5051
#   fiscalizacion | 8082  | 4202     | 5434       | 5052

# PostgreSQL
POSTGRES_DB=ayudando
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# pgAdmin 7.3
PGADMIN_EMAIL=admin@ayudando.local
PGADMIN_PASSWORD=change_me
PGADMIN_PORT=5050

# Laravel
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
JWT_SECRET=GENERATE_A_STRONG_SECRET

# Mail SMTP
MAIL_HOST=your.smtp.host
MAIL_PORT=465
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=change_me
MAIL_ENCRYPTION=tls

# Puertos expuestos (cambiar si hay conflictos)
NGINX_PORT=8080
FRONTEND_PORT=4200
