# ── Infraestructura compartida ─────────────────────────────────────────────────
# Este archivo aplica a docker-compose.shared.yml y a todos los proyectos.
# Las variables específicas de cada proyecto viven en envs/<proyecto>.env
#
# Copiá: cp .env.example .env  y completá los valores.

POSTGRES_PASSWORD=change_me
POSTGRES_USER=postgres
PGADMIN_PASSWORD=change_me

# ── Opciones generales (aplican a todos los proyectos) ─────────────────────────
APP_ENV=local
APP_DEBUG=true
MAIL_PORT=465
MAIL_ENCRYPTION=tls

# ── Puertos de host (solo si necesitás cambiarlos por conflictos) ───────────────
# AYUDANDO_NGINX_PORT=8080
# AYUDANDO_FRONTEND_PORT=4200
# EMERGENCIAS_NGINX_PORT=8081
# EMERGENCIAS_FRONTEND_PORT=4201
# FISCALIZACION_NGINX_PORT=8082
# FISCALIZACION_FRONTEND_PORT=4202
