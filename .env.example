# ============================================================
# SERVICIOS COMPARTIDOS (postgres + pgadmin)
# Un solo servidor de base de datos para todos los proyectos.
# Cada proyecto usa su propia DB dentro del mismo servidor.
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=change_me

POSTGRES_PORT=5432
PGADMIN_PORT=5050
DASHBOARD_PORT=8090

# ============================================================
# AYUDANDO
# ============================================================
AYUDANDO_APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
AYUDANDO_JWT_SECRET=GENERATE_A_STRONG_SECRET
AYUDANDO_MAIL_HOST=smtp.gmail.com
AYUDANDO_MAIL_USERNAME=your@email.com
AYUDANDO_MAIL_PASSWORD=change_me  # Gmail: usar contraseña de aplicación (no la contraseña normal)
MAIL_PORT=587
MAIL_ENCRYPTION=tls

AYUDANDO_NGINX_PORT=8080
AYUDANDO_FRONTEND_PORT=4200

# ============================================================
# EMERGENCIAS
# ============================================================
EMERGENCIAS_APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
EMERGENCIAS_JWT_SECRET=GENERATE_A_STRONG_SECRET
EMERGENCIAS_MAIL_HOST=smtp.gmail.com
EMERGENCIAS_MAIL_USERNAME=your@email.com
EMERGENCIAS_MAIL_PASSWORD=change_me  # Gmail: usar contraseña de aplicación (no la contraseña normal)

EMERGENCIAS_NGINX_PORT=8081
EMERGENCIAS_FRONTEND_PORT=4201

# ============================================================
# FISCALIZACION
# ============================================================
FISCALIZACION_APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
FISCALIZACION_JWT_SECRET=GENERATE_A_STRONG_SECRET
FISCALIZACION_MAIL_HOST=smtp.gmail.com
FISCALIZACION_MAIL_USERNAME=your@email.com
FISCALIZACION_MAIL_PASSWORD=change_me  # Gmail: usar contraseña de aplicación (no la contraseña normal)

FISCALIZACION_NGINX_PORT=8082
FISCALIZACION_FRONTEND_PORT=4202
