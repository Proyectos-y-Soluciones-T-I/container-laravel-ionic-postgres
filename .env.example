# ============================================================
# PROYECTO ACTIVO
# ============================================================
# Valores válidos: ayudando | emergencias | fiscalizacion
# Uso: make up PROJECT=ayudando
PROJECT=ayudando

# ============================================================
# AYUDANDO
# ============================================================
AYUDANDO_POSTGRES_PASSWORD=change_me
AYUDANDO_PGADMIN_PASSWORD=change_me
AYUDANDO_APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
AYUDANDO_JWT_SECRET=GENERATE_A_STRONG_SECRET
AYUDANDO_MAIL_HOST=your.smtp.host
AYUDANDO_MAIL_USERNAME=your@email.com
AYUDANDO_MAIL_PASSWORD=change_me

AYUDANDO_NGINX_PORT=8080
AYUDANDO_FRONTEND_PORT=4200
AYUDANDO_POSTGRES_PORT=5432
AYUDANDO_PGADMIN_PORT=5050

# ============================================================
# EMERGENCIAS
# ============================================================
